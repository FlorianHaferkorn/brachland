; Godot-Projektkonfiguration. Godot schreibt diese Datei beim Speichern neu —
; Handänderungen hier sind erlaubt, werden aber normalisiert.
; Doku: https://docs.godotengine.org/en/stable/classes/class_projectsettings.html

config_version=5

[application]

config/name="game-dev"
config/description="3D-Solo-Projekt. Konzept: siehe docs/GDD.md"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[dotnet]

project/assembly_name="game-dev"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
