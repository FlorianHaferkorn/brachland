{
  "name": "brachland",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D-Creature-Collector als offline-PWA. Reale Alpenregion aus OSM + EU-DEM.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "validate": "node scripts/validate.mjs",
    "quality": "node scripts/quality.mjs",
    "lod": "node scripts/lod-budget.mjs",
    "masstab": "node scripts/masstab.mjs",
    "world": "node scripts/world.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.3"
  }
}
